APP_NAME="Vidio Music"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Batas frontend yang diizinkan mengakses API (CORS)
FRONTEND_URL=http://localhost:5173

# Database lokal pakai SQLite (cukup 1 file, tidak perlu instal MySQL
# server untuk development). File-nya ada di backend/database/database.sqlite
DB_CONNECTION=sqlite

# Kalau nanti mau pakai MySQL lokal (misal sudah punya XAMPP), ganti baris
# di atas jadi DB_CONNECTION=mysql lalu hapus tanda # di 5 baris ini:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vidio_music
# DB_USERNAME=root
# DB_PASSWORD=

# Disk penyimpanan file media (video & musik) asli
FILESYSTEM_DISK=public

# Ukuran maksimal upload (MB) - sesuaikan juga di php.ini (upload_max_filesize, post_max_size)
MEDIA_MAX_UPLOAD_MB=500

# ── Production (Railway) ─────────────────────────────────────────
# APP_URL=https://<nama-service-kamu>.up.railway.app
# FRONTEND_URL=https://<nama-proyek-kamu>.vercel.app
#
# Database: buat plugin "MySQL" di Railway, lalu Railway otomatis
# mengisi DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD -
# tinggal hubungkan variabel-variabel itu di tab "Variables" service backend.
#
# Storage file video/musik: tambahkan "Volume" di Railway, mount ke
# path /app/storage/app/public, supaya file tidak hilang tiap redeploy.

# API Key YouTube Data API v3 (untuk fitur "Discover" otomatis di
# beranda). Daftar gratis di https://console.cloud.google.com
# lalu aktifkan "YouTube Data API v3" dan buat API Key.
YOUTUBE_API_KEY=
